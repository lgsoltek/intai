# Your openai api key. (required)
OPENAI_API_KEY=sk-xxxx

# Access password, separated by comma. (optional)
CODE=your-password

# You can start service behind a proxy. (optional)
PROXY_URL=http://localhost:7890

# Override openai api request base url. (optional)
# Default: https://api.openai.com
# Examples: http://your-openai-proxy.com
BASE_URL=

# Optional multiprovider mode. When set, server-side providers are exposed as
# selectable models and can be routed independently by provider id.
PROVIDERS=

# Example provider: burn.hair
PROVIDER_BURNHAIR_NAME=Burn Hair
PROVIDER_BURNHAIR_BASE_URL=https://burn.hair
PROVIDER_BURNHAIR_API_KEY=
PROVIDER_BURNHAIR_MODELS=+gpt-4.1=gpt-4.1,+gpt-4o-mini=gpt-4o-mini,+gpt-5=gpt-5,+gpt-5-codex=gpt-5-codex,+gpt-5.2=gpt-5.2

# Example provider: OpenRouter
PROVIDER_OPENROUTER_NAME=OpenRouter
PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_OPENROUTER_MODELS=+anthropic/claude-3-haiku=Claude 3 Haiku,+deepseek/deepseek-v4-flash=DeepSeek V4 Flash,+deepseek/deepseek-v4-pro=DeepSeek V4 Pro,+google/gemini-2.5-flash=Gemini 2.5 Flash,+google/gemini-3.1-flash-lite-preview=Gemini 3.1 Flash Lite Preview,+google/gemma-4-31b-it=Gemma 4 31B IT,+qwen/qwen3.6-plus=Qwen3.6 Plus

# Optional password for Settings > full provider model catalog.
MODEL_CATALOG_PASSWORD=

# Optional title/history summary override. If unset, the app uses the active
# chat provider/model, except for legacy gpt-* fallback behavior.
SUMMARY_MODELS=burnhair:gpt-4.1,openrouter:google/gemini-2.5-flash
SUMMARY_PROVIDER=
SUMMARY_MODEL=

# Specify OpenAI organization ID.(optional)
# Default: Empty
OPENAI_ORG_ID=

# (optional)
# Default: Empty
# If you do not want users to use GPT-4, set this value to 1.
DISABLE_GPT4=

# (optional)
# Default: Empty
# If you do not want users to input their own API key, set this value to 1.
HIDE_USER_API_KEY=

# (optional)
# Default: Empty
# If you do want users to query balance, set this value to 1.
ENABLE_BALANCE_QUERY=

# (optional)
# Default: Empty
# If you want to disable parse settings from url, set this value to 1.
DISABLE_FAST_LINK=

# (optional)
# Default: Empty
# To control custom models, use + to add a custom model, use - to hide a model, use name=displayName to customize model name, separated by comma.
CUSTOM_MODELS=

# (optional)
# Default: Empty
# Change default model
DEFAULT_MODEL=

# Optional homework-specific system prompt.
# Set this in Vercel and redeploy to change assignments without editing code.
NEXT_PUBLIC_SYSTEM_PROMPT=

# Optional student list CSV path. If unset, Vercel builds on main use
# /students-main.csv, builds on multiprovider use /students-multiprovider.csv,
# and local/dev builds fall back to /students.csv.
NEXT_PUBLIC_STUDENTS_CSV_PATH=

### (optional)
WHITE_WEBDEV_ENDPOINTS=
